pipeline {
    agent any

    stages {
        stage('clone') {
            steps {
               git 'https://github.com/openwriteup/java11-jenkins.git'
            }
        }
	  stage('build') {
            steps {
               sh '''sudo docker build -t sonalisnehi/javatest -f dockerfile .
'''
            }
        }

		stage('docker login and puh image') {
            steps {
					withCredentials([usernamePassword(credentialsId: 'mytoken', passwordVariable: 'password', usernameVariable: 'username')]) {
               sh '''echo $password |docker login -u $username --password-stdin
				 	  docker push sonalisnehi/javatest'''
			}
            }
        }

		stage('install trivy') {
            steps {
               sh '''sudo apt-get install wget gnupg
wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | gpg --dearmor | sudo tee /usr/share/keyrings/trivy.gpg > /dev/null
echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main" | sudo tee -a /etc/apt/sources.list.d/trivy.list
sudo apt-get update
sudo apt-get install trivy'''
            }
        }

stage('trivy scan') {
            steps {
               sh '''trivy image sonalisnehi/javatest'''
            }
        }


stage(' see dashboard scan') {
            steps {
            sh ' trivy image --format json --output result.json --severity HIGH,CRITICAL sonalisnehi/javatest'
				archiveArtifacts artifacts: 'result.json', followSymlinks: false
            }
        }


stage('Mailing') {
            steps {
               mail bcc: '', body: 'Echo status', cc: '', from: 'sonali.friendly@gmail.com', replyTo: '', subject: 'Echo JobStatus of Trivy by jenkins', to: 'sonali.friendly@gmail.com'
            }
        }
    }
}
