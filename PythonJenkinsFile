pipeline {
    agent any

    environment {
        SONAR_SCANNER = "/opt/sonar-scanner/bin/sonar-scanner"
    }

    stages {
        stage('Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/sonalisnehi108/cicdproject.git'
            }
            post {
                success {
                    slackSend(channel: '#cicd-alerts', color: '#36a64f',
                        message: "✅ Clone succeeded for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
                failure {
                    slackSend(channel: '#cicd-alerts', color: '#FF0000',
                        message: "❌ Clone failed for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
                
            }
        }



        stage('Slack Test') {
            steps {
                slackSend(message: "🔔 Test message from Jenkins job ${env.JOB_NAME} #${env.BUILD_NUMBER}")
            }
        }

        stage('Build') {
            steps {
                sh 'sudo docker build -t sonalisnehi/pyproject1 -f Dockerfile .'
            }
            post {
                success {
                    slackSend(channel: '#cicd-alerts', color: '#36a64f',
                        message: "✅ Build succeeded for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
                failure {
                    slackSend(channel: '#cicd-alerts', color: '#FF0000',
                        message: "❌ Build failed for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
            }
        }

        stage('Docker Login & Push Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'mytoken', passwordVariable: 'password', usernameVariable: 'username')]) {
                    sh '''
                        echo $password | docker login -u $username --password-stdin
                        docker push sonalisnehi/pyproject1
                    '''
                }
            }
            post {
                success {
                    slackSend(channel: '#cicd-alerts', color: '#36a64f',
                        message: "📦 Docker push succeeded for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
                failure {
                    slackSend(channel: '#cicd-alerts', color: '#FF0000',
                        message: "❌ Docker push failed for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
            }
        }

        stage('Install SonarQube CLI') {
            steps {
                sh '''
                    sudo apt update -y
                    sudo apt install unzip wget -y
                    wget -O sonar-scanner.zip https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-5.0.1.3006-linux.zip
                    unzip -o -q sonar-scanner.zip
                    sudo rm -rf /opt/sonar-scanner
                    sudo mv --force sonar-scanner-5.0.1.3006-linux /opt/sonar-scanner
                '''
            }
            post {
                success {
                    slackSend(channel: '#cicd-alerts', color: '#36a64f',
                        message: "🔧 SonarQube CLI installed successfully")
                }
                failure {
                    slackSend(channel: '#cicd-alerts', color: '#FF0000',
                        message: "❌ SonarQube CLI installation failed")
                }
            }
        }

        stage('Analyze Code Quality') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh '''
                        $SONAR_SCANNER \
                          -Dsonar.projectKey=upgradmanualorg_masterclassproject \
                          -Dsonar.organization=upgradmanualorg \
                          -Dsonar.qualitygate.wait=false \
                          -Dsonar.qualitygate.timeout=300 \
                          -Dsonar.sources=. \
                          -Dsonar.host.url=https://sonarcloud.io \
                          -Dsonar.login=$SONAR_TOKEN
                    '''
                }
            }
            post {
                always {
                    slackSend(channel: '#cicd-alerts', color: '#439FE0',
                        message: "📊 Sonar analysis completed for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
            }
        }

        stage('Install Trivy') {
            steps {
                sh '''
                    sudo apt-get install wget gnupg -y
                    wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | gpg --dearmor | sudo tee /usr/share/keyrings/trivy.gpg > /dev/null
                    echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main" | sudo tee /etc/apt/sources.list.d/trivy.list
                    sudo apt-get update
                    sudo apt-get install trivy -y
                '''
            }
            post {
                success {
                    slackSend(channel: '#cicd-alerts', color: '#36a64f',
                        message: "🔧 Trivy installed successfully")
                }
                failure {
                    slackSend(channel: '#cicd-alerts', color: '#FF0000',
                        message: "❌ Trivy installation failed")
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh 'trivy image sonalisnehi/pyproject1'
            }
            post {
                always {
                    slackSend(channel: '#cicd-alerts', color: '#FFA500',
                        message: "🔒 Trivy scan finished for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
            }
        }

        stage('Dashboard Scan') {
            steps {
                sh 'trivy image --format json --output result.json --severity HIGH,CRITICAL sonalisnehi/pyproject1'
                archiveArtifacts artifacts: 'result.json', followSymlinks: false
            }
            post {
                always {
                    slackSend(channel: '#cicd-alerts', color: '#439FE0',
                        message: "📊 Dashboard scan results archived for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
            }
        }

        stage('Mailing') {
            steps {
                mail bcc: '', body: 'Echo status', cc: '', from: 'sonali.friendly@gmail.com',
                     replyTo: '', subject: 'Echo JobStatus of Trivy by Jenkins',
                     to: 'sonali.friendly@gmail.com'
            }
            post {
                always {
                    slackSend(channel: '#cicd-alerts', color: '#439FE0',
                        message: "📧 Email notification sent for ${env.JOB_NAME} #${env.BUILD_NUMBER}")
                }
            }
        }
    }

    post {
        success {
            slackSend(channel: '#cicd-alerts', color: '#36a64f',
                message: "🎉 Pipeline SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}")
        }
        failure {
            slackSend(channel: '#cicd-alerts', color: '#FF0000',
                message: "🚨 Pipeline FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}")
        }
    }
}
